{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-machine-qualification-plan.schema.json",
  "title":"Glaze UI V1.6 Machine Qualification Plan",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","planId","name","lifecycle","sourceRevision","stableBaseline",
    "acceptanceModelVersion","consumerEligible","machineEvidenceLaneIds","nonMachineOnlyLaneIds",
    "validators","expectedMachineMatrixDisposition","boundary"
  ],
  "properties":{
    "$schema":{"const":"../../schemas/v1.6-machine-qualification-plan.schema.json"},
    "schemaVersion":{"const":1},
    "planId":{"const":"goreecloud.glaze-ui.v1.6.machine-qualification"},
    "name":{"const":"Glaze UI V1.6 Machine Qualification Plan"},
    "lifecycle":{"const":"DevelopmentQualification"},
    "sourceRevision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "stableBaseline":{"const":"1.5.1"},
    "acceptanceModelVersion":{"const":"1.6.0-dev.12"},
    "consumerEligible":{"const":false},
    "machineEvidenceLaneIds":{"type":"array","minItems":20,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "nonMachineOnlyLaneIds":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "validators":{
      "type":"array","minItems":12,"maxItems":12,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","path"],
        "properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1}}
      }
    },
    "expectedMachineMatrixDisposition":{"type":"object","minProperties":5},
    "boundary":{"type":"string","minLength":1}
  }
}
