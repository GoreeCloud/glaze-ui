{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-rendered-qualification-plan.schema.json",
  "title":"Glaze UI V1.6 Exact-Source Rendered Browser Qualification Plan",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","planId","name","lifecycle","sourceRevision",
    "acceptanceModelVersion","stableBaseline","consumerEligible","harness",
    "eligibleRenderedEvidenceLaneIds","expectedMatrixDispositionAfterAcceptedRenderedEvidence",
    "scenes","evidenceBoundary","boundary"
  ],
  "properties":{
    "$schema":{"const":"../../schemas/v1.6-rendered-qualification-plan.schema.json"},
    "schemaVersion":{"const":1},
    "planId":{"const":"goreecloud.glaze-ui.v1.6.rendered-browser-qualification"},
    "name":{"const":"Glaze UI V1.6 Exact-Source Rendered Browser Qualification Plan"},
    "lifecycle":{"const":"DevelopmentQualification"},
    "sourceRevision":{"const":"c7509c79256b04b0aa67cb9dd0737d7588e0ae4a"},
    "acceptanceModelVersion":{"const":"1.6.0-dev.12"},
    "stableBaseline":{"const":"1.5.1"},
    "consumerEligible":{"const":false},
    "harness":{"const":"reference/v1.6/rendered-qualification.html"},
    "eligibleRenderedEvidenceLaneIds":{
      "type":"array","minItems":8,"maxItems":8,"uniqueItems":true,
      "items":{"enum":[
        "reduced-motion","reduced-transparency","increased-contrast","large-text",
        "responsive-layouts","form-factor-transitions","layout-stability","representative-rendering"
      ]}
    },
    "expectedMatrixDispositionAfterAcceptedRenderedEvidence":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "verifiedLaneCount","unverifiedLaneCount","notApplicableLaneCount",
        "fullyVerifiedByThisCheckpoint","partialRenderedLaneIds",
        "remainingPartialLaneIds","remainingUntouchedLaneIds",
        "qualificationEvidenceComplete","readyForGovernedQualificationReview"
      ],
      "properties":{
        "verifiedLaneCount":{"const":16},
        "unverifiedLaneCount":{"const":8},
        "notApplicableLaneCount":{"const":0},
        "fullyVerifiedByThisCheckpoint":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"type":"string"}},
        "partialRenderedLaneIds":{"const":["representative-rendering"]},
        "remainingPartialLaneIds":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"string"}},
        "remainingUntouchedLaneIds":{"const":["assistive-technology","performance"]},
        "qualificationEvidenceComplete":{"const":false},
        "readyForGovernedQualificationReview":{"const":false}
      }
    },
    "scenes":{
      "type":"array","minItems":9,"maxItems":9,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","viewport","environment","mode"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "viewport":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":320,"maximum":4096}},
          "environment":{"enum":["compact","medium","expanded"]},
          "mode":{"enum":["default","reduced-motion","reduced-transparency","increased-contrast","large-text","layout-stability","form-factor-transition"]},
          "mobile":{"type":"boolean"},
          "mediaFeatures":{
            "type":"array",
            "items":{
              "type":"object","additionalProperties":false,
              "required":["name","value"],
              "properties":{"name":{"type":"string","minLength":1},"value":{"type":"string","minLength":1}}
            }
          }
        }
      }
    },
    "evidenceBoundary":{
      "type":"object","additionalProperties":false,
      "required":[
        "renderedBrowserOnly","humanEvidenceClaimed","assistiveTechnologyEvidenceClaimed",
        "physicalDeviceEvidenceClaimed","nativePlatformEvidenceClaimed",
        "representativePerformanceEvidenceClaimed","regressionBaselineClaimed",
        "lifecyclePromotionAutomatic","stableStatusGranted","consumerAcceptanceAutomatic",
        "deploymentAcceptanceAutomatic","productionAcceptanceAutomatic"
      ],
      "properties":{
        "renderedBrowserOnly":{"const":true},
        "humanEvidenceClaimed":{"const":false},
        "assistiveTechnologyEvidenceClaimed":{"const":false},
        "physicalDeviceEvidenceClaimed":{"const":false},
        "nativePlatformEvidenceClaimed":{"const":false},
        "representativePerformanceEvidenceClaimed":{"const":false},
        "regressionBaselineClaimed":{"const":false},
        "lifecyclePromotionAutomatic":{"const":false},
        "stableStatusGranted":{"const":false},
        "consumerAcceptanceAutomatic":{"const":false},
        "deploymentAcceptanceAutomatic":{"const":false},
        "productionAcceptanceAutomatic":{"const":false}
      }
    },
    "boundary":{"type":"string","minLength":1}
  }
}
