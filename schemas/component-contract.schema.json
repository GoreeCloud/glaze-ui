{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.github.io/glaze-ui/schemas/component-contract.schema.json",
  "title": "Glaze UI 2.1 Candidate Component Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "lifecycle",
    "semanticRole",
    "materialRole",
    "geometry",
    "states",
    "targets",
    "input",
    "accessibility",
    "density",
    "formFactors",
    "fallbacks",
    "visualReview"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["stable", "candidate", "experimental", "planned", "deprecated", "historical"]},
    "since": {"type": "string"},
    "semanticRole": {"type": "string", "minLength": 1},
    "materialRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowed"],
      "properties": {
        "default": {"enum": ["canvas", "surface", "soft-glaze", "glaze", "deep-glaze", "live-glaze"]},
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["canvas", "surface", "soft-glaze", "glaze", "deep-glaze", "live-glaze"]}
        },
        "budgetRole": {"enum": ["content", "persistent-interaction", "floating-interaction", "transient-elevated", "active-live"]}
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["display-xl", "display", "headline-xl", "headline", "title", "body-large", "body", "label", "caption"]}},
        "largeTextReflowRequired": {"type": "boolean"}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radiusRoles"],
      "properties": {
        "family": {"enum": ["utility", "expression"]},
        "radiusRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["micro", "small", "standard", "medium", "large", "hero", "circular", "capsule"]}},
        "concentricNesting": {"type": "boolean"},
        "opticalCorrectionAllowed": {"type": "boolean"}
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenRoles": {"type": "array", "items": {"type": "string"}},
        "arbitrarySpacingProhibited": {"type": "boolean"}
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticRoles": {"type": "array", "items": {"type": "string"}},
        "colorIndependentStateRequired": {"type": "boolean"}
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["default", "hover", "focus", "pressed", "selected", "disabled", "loading", "indeterminate", "success", "information", "warning", "error", "destructive", "offline", "unavailable", "protected", "restricted", "syncing"]}
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["touchMinPx", "pointerMinPx"],
      "properties": {
        "touchMinPx": {"type": "integer", "minimum": 1},
        "pointerMinPx": {"type": "integer", "minimum": 1},
        "tvMinPx": {"type": "integer", "minimum": 1},
        "visualSizeMayDifferFromHitArea": {"type": "boolean"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "focus", "press"],
      "properties": {
        "keyboard": {"type": "string", "minLength": 1},
        "focus": {"type": "string", "minLength": 1},
        "hover": {"type": "string"},
        "press": {"type": "string", "minLength": 1},
        "selection": {"type": "string"},
        "directional": {"type": "string"},
        "directManipulation": {"type": "string"}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "timing": {"enum": ["instant", "fast", "standard", "emphasized"]},
        "spring": {"enum": ["restrained", "standard", "expressive", "spatial"]},
        "interruptible": {"type": "boolean"},
        "reversible": {"type": "boolean"},
        "reducedMotionAlternative": {"type": "string"}
      }
    },
    "haptics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["tap", "toggle", "selection", "threshold", "snap", "drop", "success", "warning", "error", "confirmation", "protected-action"]}},
        "optionalWhenUnsupported": {"type": "boolean"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "reducedMotion", "reducedTransparency", "increasedContrast", "largeText", "forcedColors"],
      "properties": {
        "semantics": {"type": "string", "minLength": 1},
        "reducedMotion": {"type": "string", "minLength": 1},
        "reducedTransparency": {"type": "string", "minLength": 1},
        "increasedContrast": {"type": "string", "minLength": 1},
        "largeText": {"type": "string", "minLength": 1},
        "forcedColors": {"type": "string", "minLength": 1},
        "showBoundaries": {"type": "string"},
        "touchAssistance": {"type": "string"}
      }
    },
    "density": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["comfortable", "standard", "compact", "far-view"]}
    },
    "formFactors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["mobile", "tablet", "desktop", "wide-desktop", "tv", "foldable", "resizable"]}
    },
    "adaptiveTransformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "preserve"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "motion", "performance"],
      "properties": {
        "material": {"type": "string", "minLength": 1},
        "motion": {"type": "string", "minLength": 1},
        "performance": {"type": "string", "minLength": 1}
      }
    },
    "nativeMappings": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "platformStateSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["privacy-shield", "wardveil-security", "everkeep", "goreecloud-sync", "goreecloud-identity", "goreecloud-mesh", "application"]}
    },
    "visualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "criteria"],
      "properties": {
        "required": {"type": "boolean"},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "opticalNotes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
