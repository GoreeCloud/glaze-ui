{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-continuity-aware-motion.schema.json",
  "title": "Glaze UI V1.7 Continuity-Aware Motion Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "name",
    "version",
    "lifecycle",
    "stableBaseline",
    "consumerEligible",
    "planVersion",
    "v11SpecificationSections",
    "continuityEvents",
    "principles",
    "authority",
    "accessibility",
    "acceptanceBoundary",
    "integrationFoundations",
    "runtimeEntrypoint",
    "developmentAggregateEntrypoint",
    "tokenMap",
    "sourceAuthorities"
