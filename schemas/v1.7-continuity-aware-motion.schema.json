  "properties": {
    "$schema": {
      "const": "../../schemas/v1.7-continuity-aware-motion.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "goreecloud.glaze-ui.v1.7.continuity-aware-motion"
    },
    "name": {
