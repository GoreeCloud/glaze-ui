{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-machine-evidence.schema.json",
  "title":"Glaze UI V1.6 Exact-Source Machine Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","recordId","name","lifecycle","sourceRevision",
    "acceptanceModelVersion","stableBaseline","qualificationRun","validatorsPassed",
    "machineEvidence","matrixDisposition","authority","boundary"
  ],
  "properties":{
    "$schema":{"const":"../schemas/v1.6-machine-evidence.schema.json"},
    "schemaVersion":{"const":1},
    "recordId":{"const":"goreecloud.glaze-ui.v1.6.machine-evidence"},
    "name":{"const":"Glaze UI V1.6 Exact-Source Machine Evidence"},
    "lifecycle":{"const":"DevelopmentQualification"},
    "sourceRevision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "acceptanceModelVersion":{"const":"1.6.0-dev.12"},
    "stableBaseline":{"const":"1.5.1"},
    "qualificationRun":{
      "type":"object","additionalProperties":false,
      "required":["runId","jobId","toolingRevision","conclusion","observedAt","reference"],
      "properties":{
        "runId":{"type":"integer","minimum":1},
        "jobId":{"type":"integer","minimum":1},
        "toolingRevision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "conclusion":{"const":"success"},
        "observedAt":{"type":"string","minLength":1},
        "reference":{"type":"string","minLength":1}
      }
    },
    "validatorsPassed":{"type":"array","minItems":12,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "machineEvidence":{
      "type":"array","minItems":20,"maxItems":20,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","verified","revision","evidenceType","reference"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "verified":{"const":true},
          "revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
          "evidenceType":{"const":"machine"},
          "reference":{"type":"string","minLength":1}
        }
      }
    },
    "matrixDisposition":{"type":"object","minProperties":8},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":[
        "renderedEvidenceClaimed","humanEvidenceClaimed","assistiveTechnologyEvidenceClaimed",
        "deviceEvidenceClaimed","performanceEvidenceClaimed","candidateStatusGranted",
        "releaseCandidateStatusGranted","stableStatusGranted","consumerAcceptanceAutomatic",
        "deploymentAcceptanceAutomatic","productionAcceptanceAutomatic"
      ],
      "properties":{
        "renderedEvidenceClaimed":{"const":false},
        "humanEvidenceClaimed":{"const":false},
        "assistiveTechnologyEvidenceClaimed":{"const":false},
        "deviceEvidenceClaimed":{"const":false},
        "performanceEvidenceClaimed":{"const":false},
        "candidateStatusGranted":{"const":false},
        "releaseCandidateStatusGranted":{"const":false},
        "stableStatusGranted":{"const":false},
        "consumerAcceptanceAutomatic":{"const":false},
        "deploymentAcceptanceAutomatic":{"const":false},
        "productionAcceptanceAutomatic":{"const":false}
      }
    },
    "boundary":{"type":"string","minLength":1}
  }
}
