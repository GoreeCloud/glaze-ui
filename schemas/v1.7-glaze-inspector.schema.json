    "consumerEligible",
    "planVersion",
    "v11SpecificationSections",
    "inspectionDomains",
    "provenanceSources",
    "resolutionRequirements",
    "authority",
    "privacy",
    "acceptanceBoundary",
    "integrationFoundations",
