{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-glaze-inspector.schema.json",
  "title": "Glaze UI V1.7 Glaze Inspector Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
