    },
    "provenanceSources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolutionRequirements": {
      "type": "object",
      "minProperties": 16
    },
    "authority": {
      "type": "object",
      "minProperties": 12
    },
    "privacy": {
      "type": "object",
      "minProperties": 5
    },
    "acceptanceBoundary": {
      "type": "object",
      "minProperties": 10
    },
    "integrationFoundations": {
      "type": "object",
      "minProperties": 5
    },
    "runtimeEntrypoint": {
      "const": "js/glaze-v1.7-inspector.dev.mjs"
    },
    "developmentAggregateEntrypoint": {
      "const": "js/glaze-v1.7-development.mjs"
    },
    "tokenMap": {
      "const": "tokens/glaze-v1.7-inspector.dev.json"
    },
    "sourceAuthorities": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
