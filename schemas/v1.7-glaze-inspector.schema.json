    },
    "v11SpecificationSections": {
      "const": [
        26
      ]
    },
    "inspectionDomains": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
