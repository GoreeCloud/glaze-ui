{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-resilience-feedback.schema.json",
  "title":"Glaze UI V1.6 Resilience Feedback Development Contract",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","contractId","name","version","lifecycle",
    "stableBaseline","consumerEligible","implementedSpecificationSections",
    "emptyStates","errors","recovery","connectivity","staleAndRefresh",
    "optimisticInteraction","progress","notifications","messageSurfaces",
    "dialogs","destructiveActions","authority","runtimeEntrypoint",
    "developmentAggregateEntrypoint","tokenMap","boundary"
  ],
  "properties":{
    "$schema":{"const":"../../schemas/v1.6-resilience-feedback.schema.json"},
    "schemaVersion":{"const":1},
    "contractId":{"const":"goreecloud.glaze-ui.v1.6.resilience-feedback"},
    "name":{"const":"Glaze UI V1.6 Resilience, Recovery, Progress, Notification, and Dialog Development Contract"},
    "version":{"const":"1.6.0-dev.5"},
    "lifecycle":{"const":"Development"},
    "stableBaseline":{"const":"1.5.1"},
    "consumerEligible":{"const":false},
    "implementedSpecificationSections":{
      "type":"array","minItems":12,"maxItems":12,"uniqueItems":true,
      "items":{"type":"integer","minimum":1,"maximum":100}
    },
    "emptyStates":{"type":"object","minProperties":3},
    "errors":{"type":"object","minProperties":3},
    "recovery":{"type":"object","minProperties":4},
    "connectivity":{"type":"object","minProperties":3},
    "staleAndRefresh":{"type":"object","minProperties":5},
    "optimisticInteraction":{"type":"object","minProperties":7},
    "progress":{"type":"object","minProperties":4},
    "notifications":{"type":"object","minProperties":3},
    "messageSurfaces":{"type":"object","minProperties":5},
    "dialogs":{"type":"object","minProperties":9},
    "destructiveActions":{"type":"object","minProperties":8},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":[
        "boundary","stateTruthOwnedByCallerOrProvider","dataSafetyTruthOwnedByCaller",
        "recoveryCapabilityOwnedByCaller","connectivityTruthOwnedByCallerOrProvider",
        "criticalityOwnedByCallerOrProvider","permissionOrAuthorizationInferred",
        "consequentialExecutionAutomatic"
      ],
      "properties":{
        "boundary":{"const":"presentation-only"},
        "stateTruthOwnedByCallerOrProvider":{"const":true},
        "dataSafetyTruthOwnedByCaller":{"const":true},
        "recoveryCapabilityOwnedByCaller":{"const":true},
        "connectivityTruthOwnedByCallerOrProvider":{"const":true},
        "criticalityOwnedByCallerOrProvider":{"const":true},
        "permissionOrAuthorizationInferred":{"const":false},
        "consequentialExecutionAutomatic":{"const":false}
      }
    },
    "runtimeEntrypoint":{"const":"js/glaze-v1.6-resilience-feedback.dev.mjs"},
    "developmentAggregateEntrypoint":{"const":"js/glaze-v1.6-development.mjs"},
    "tokenMap":{"const":"tokens/glaze-v1.6-resilience-feedback.dev.json"},
    "boundary":{"type":"string","minLength":1}
  }
}
