    "acceptanceBoundary": {"type":"object","minProperties":17},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-adaptive-composition-motion.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
