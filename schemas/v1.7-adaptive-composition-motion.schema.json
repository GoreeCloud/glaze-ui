    "compositionPolicy": {"type":"object","minProperties":8,"maxProperties":8},
    "supportedAdaptiveContexts": {"type":"array","minItems":4,"uniqueItems":true},
    "requestPolicy": {"type":"object","minProperties":9},
    "continuity": {"type":"object","minProperties":12},
    "authority": {"type":"object","minProperties":10},
    "accessibility": {"type":"object","minProperties":6},
    "performance": {"type":"object","minProperties":5},
