{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-signature-motion-system.schema.json",
  "title": "Glaze UI V1.7 Signature Motion System Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "name",
    "version",
    "lifecycle",
    "stableBaseline",
    "consumerEligible",
    "planVersion",
    "v12SpecificationSections",
    "motionPillars",
    "semanticRelationships",
    "signatureFamilies",
    "relationshipToFamily",
    "principles",
    "authority",
    "accessibility",
    "glazeMotionBoundary",
    "acceptanceBoundary",
    "integrationFoundations",
    "runtimeEntrypoint",
    "developmentAggregateEntrypoint",
    "tokenMap",
    "sourceAuthorities"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/v1.7-signature-motion-system.schema.json"},
    "schemaVersion": {"const": 1},
    "contractId": {"const": "goreecloud.glaze-ui.v1.7.signature-motion-system"},
    "name": {"const": "Glaze UI V1.7 Signature Motion System Development Contract"},
    "version": {"const": "1.7.0-dev.14"},
    "lifecycle": {"const": "Development"},
    "stableBaseline": {"const": "1.6.0"},
    "consumerEligible": {"const": false},
    "planVersion": {"const": "v1.2"},
    "v12SpecificationSections": {"const": [22]},
    "motionPillars": {
      "const": ["continuity", "depth", "material", "precision", "quiet-settling"]
    },
    "semanticRelationships": {
      "const": [
        "same-object-expansion",
        "workspace-recomposition",
        "transient-elevation",
        "context-overlay",
        "posture-partition",
        "source-destination-continuity",
        "direct-manipulation-settle",
        "focus-transfer",
        "color-state-change",
        "material-role-change"
      ]
    },
    "signatureFamilies": {
      "const": [
        "Glaze Bloom",
        "Glaze Flow",
        "Glaze Lift",
        "Glaze Veil",
        "Glaze Fold",
        "Glaze Trace",
        "Glaze Settle",
        "Glaze Focus Transfer",
        "Glaze Color Shift",
        "Glaze Material Shift"
      ]
    },
    "relationshipToFamily": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "string"}},
    "principles": {"type": "object", "minProperties": 10},
    "authority": {"type": "object", "minProperties": 13},
    "accessibility": {"type": "object", "minProperties": 5},
    "glazeMotionBoundary": {"type": "object", "minProperties": 5},
    "acceptanceBoundary": {"type": "object", "minProperties": 14},
    "integrationFoundations": {"type": "object", "minProperties": 4},
    "runtimeEntrypoint": {"const": "js/glaze-v1.7-signature-motion-system.dev.mjs"},
    "developmentAggregateEntrypoint": {"const": "js/glaze-v1.7-development.mjs"},
    "tokenMap": {"const": "tokens/glaze-v1.7-signature-motion-system.dev.json"},
    "sourceAuthorities": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
