{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/consumer-registry.schema.json",
  "title": "Glaze UI Consumer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stableBaseline",
    "requiredConsumerVersion",
    "historicalStableVersions",
    "auditedAt",
    "statusVocabulary",
    "enforcement",
    "candidateAssessment",
    "consumers"
  ],
  "properties": {
    "schemaVersion": {"const": 4},
    "stableBaseline": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "requiredConsumerVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "historicalStableVersions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
    },
    "auditedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "statusVocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["aligned-current-stable", "adoption-candidate", "migration-required", "unverified"]}
    },
    "enforcement": {
      "type": "object",
      "required": ["currentStableRequired", "productionExceptionsAllowed", "platformScope", "unsupportedPlatformRule"],
      "properties": {
        "currentStableRequired": {"const": true},
        "productionExceptionsAllowed": {"const": false},
        "platformScope": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unsupportedPlatformRule": {"type": "string", "minLength": 1}
      }
    },
    "candidateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "lifecycle",
        "consumerEligible",
        "productionEligible",
        "evaluationStatusVocabulary",
        "requiredEvidence",
        "coverageRule",
        "rule",
        "evaluations"
      ],
      "properties": {
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-candidate\\.\\d+$"},
        "lifecycle": {"const": "candidate"},
        "consumerEligible": {"const": false},
        "productionEligible": {"const": false},
        "evaluationStatusVocabulary": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["evaluation-in-progress", "evaluation-complete", "blocked"]}
        },
        "requiredEvidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "coverageRule": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "status", "targetVersion", "referenceRevision", "evidence", "automatedContract", "productionEligible", "stableConformanceUnaffected", "acceptanceBoundary"],
            "properties": {
              "repository": {"type": "string", "pattern": "^GoreeCloud/.+$"},
              "status": {"enum": ["evaluation-in-progress", "evaluation-complete", "blocked"]},
              "targetVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-candidate\\.\\d+$"},
              "referenceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "evidence": {"type": "string", "minLength": 1},
              "automatedContract": {"const": true},
              "productionEligible": {"const": false},
              "stableConformanceUnaffected": {"const": true},
              "acceptanceBoundary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "repository", "status", "requiredTargetVersion", "automatedContract", "productionEligible", "visualAcceptance", "notes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^GoreeCloud/.+$"},
          "status": {"enum": ["aligned-current-stable", "adoption-candidate", "migration-required", "unverified"]},
          "targetVersion": {"type": ["string", "null"]},
          "requiredTargetVersion": {"type": "string"},
          "referenceRevision": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "automatedContract": {"type": "boolean"},
          "productionEligible": {"type": "boolean"},
          "visualAcceptance": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
