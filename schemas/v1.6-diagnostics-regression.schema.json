{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-diagnostics-regression.schema.json",
  "title":"Glaze UI V1.6 Diagnostics Regression Development Contract",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","contractId","name","version","lifecycle",
    "stableBaseline","consumerEligible","implementedSpecificationSections",
    "developerDiagnostics","accessibilityDiagnostics","skeletonDiagnostics",
    "visualRegression","semanticRegression","performanceRegression",
    "layoutStability","gracefulDegradation","authority","runtimeEntrypoint",
    "developmentAggregateEntrypoint","tokenMap","boundary"
  ],
  "properties":{
    "$schema":{"const":"../../schemas/v1.6-diagnostics-regression.schema.json"},
    "schemaVersion":{"const":1},
    "contractId":{"const":"goreecloud.glaze-ui.v1.6.diagnostics-regression"},
    "name":{"const":"Glaze UI V1.6 Diagnostics, Regression, Layout Stability, and Degradation Development Contract"},
    "version":{"const":"1.6.0-dev.9"},
    "lifecycle":{"const":"Development"},
    "stableBaseline":{"const":"1.5.1"},
    "consumerEligible":{"const":false},
    "implementedSpecificationSections":{
      "type":"array","minItems":8,"maxItems":8,"uniqueItems":true,
      "items":{"type":"integer","minimum":1,"maximum":100}
    },
    "developerDiagnostics":{"type":"object","minProperties":3},
    "accessibilityDiagnostics":{"type":"object","minProperties":3},
    "skeletonDiagnostics":{"type":"object","minProperties":5},
    "visualRegression":{"type":"object","minProperties":3},
    "semanticRegression":{"type":"object","minProperties":2},
    "performanceRegression":{"type":"object","minProperties":5},
    "layoutStability":{"type":"object","minProperties":4},
    "gracefulDegradation":{"type":"object","minProperties":4},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":[
        "boundary","measurementsOwnedByCallerOrHarness","renderedEvidenceManufactured",
        "acceptanceInferred","fallbackExecutionAutomatic","consequentialExecutionAutomatic"
      ],
      "properties":{
        "boundary":{"const":"evidence-evaluation-only"},
        "measurementsOwnedByCallerOrHarness":{"const":true},
        "renderedEvidenceManufactured":{"const":false},
        "acceptanceInferred":{"const":false},
        "fallbackExecutionAutomatic":{"const":false},
        "consequentialExecutionAutomatic":{"const":false}
      }
    },
    "runtimeEntrypoint":{"const":"js/glaze-v1.6-diagnostics-regression.dev.mjs"},
    "developmentAggregateEntrypoint":{"const":"js/glaze-v1.6-development.mjs"},
    "tokenMap":{"const":"tokens/glaze-v1.6-diagnostics-regression.dev.json"},
    "boundary":{"type":"string","minLength":1}
  }
}
