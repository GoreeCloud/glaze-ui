{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-expanded-component-system.schema.json",
  "title": "Glaze UI V1.7 Expanded Component System Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "name",
    "version",
    "lifecycle",
    "stableBaseline",
    "consumerEligible",
    "planVersion",
    "v11SpecificationSections",
    "componentCatalog",
    "inheritedComponents",
    "newComponentFoundations",
    "semanticRequirements",
    "componentFamilies",
    "authority",
    "acceptanceBoundary",
    "integrationFoundations",
    "runtimeEntrypoint",
    "developmentAggregateEntrypoint",
    "tokenMap",
    "sourceAuthorities"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/v1.7-expanded-component-system.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "goreecloud.glaze-ui.v1.7.expanded-component-system"
    },
    "name": {
      "const": "Glaze UI V1.7 Expanded Component System Development Contract"
    },
    "version": {
      "const": "1.7.0-dev.10"
    },
    "lifecycle": {
      "const": "Development"
    },
    "stableBaseline": {
      "const": "1.6.0"
    },
    "consumerEligible": {
      "const": false
    },
    "planVersion": {
      "const": "v1.1"
    },
    "v11SpecificationSections": {
      "const": [
        25
      ]
    },
    "componentCatalog": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inheritedComponents": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "newComponentFoundations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semanticRequirements": {
      "type": "object",
      "minProperties": 8
    },
    "componentFamilies": {
      "type": "object",
      "minProperties": 4
    },
    "authority": {
      "type": "object",
      "minProperties": 10
    },
    "acceptanceBoundary": {
      "type": "object",
      "minProperties": 9
    },
    "integrationFoundations": {
      "type": "object",
      "minProperties": 5
    },
    "runtimeEntrypoint": {
      "const": "js/glaze-v1.7-expanded-component-system.dev.mjs"
    },
    "developmentAggregateEntrypoint": {
      "const": "js/glaze-v1.7-development.mjs"
    },
    "tokenMap": {
      "const": "tokens/glaze-v1.7-expanded-component-system.dev.json"
    },
    "sourceAuthorities": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
