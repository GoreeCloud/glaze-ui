{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/v1.6-qualification-evidence-intake.schema.json",
  "title": "Glaze UI V1.6 Qualification Evidence Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema","schemaVersion","contractId","name","lifecycle","sourceRevision",
    "acceptanceModelVersion","stableBaseline","canonicalEvidenceRecords",
    "acceptedExternalRecordIds","externalRecordValidator",
    "currentDispositionWithoutExternalEvidence","authority","boundary"
  ],
  "properties": {
    "$schema": {"const":"../../schemas/v1.6-qualification-evidence-intake.schema.json"},
    "schemaVersion": {"const":1},
    "contractId": {"const":"goreecloud.glaze-ui.v1.6.qualification-evidence-intake"},
    "name": {"const":"Glaze UI V1.6 Qualification Evidence Intake"},
    "lifecycle": {"const":"DevelopmentQualification"},
    "sourceRevision": {"const":"c7509c79256b04b0aa67cb9dd0737d7588e0ae4a"},
    "acceptanceModelVersion": {"const":"1.6.0-dev.12"},
    "stableBaseline": {"const":"1.5.1"},
    "canonicalEvidenceRecords": {
      "type":"array","minItems":3,"maxItems":3,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["type","path","validator"],
        "properties":{
          "type":{"enum":["machine","rendered","rendered-regression"]},
          "path":{"type":"string","minLength":1},
          "validator":{"type":"string","minLength":1}
        }
      }
    },
    "acceptedExternalRecordIds": {
      "type":"array","minItems":3,"maxItems":3,"uniqueItems":true,
      "items":{"enum":[
        "goreecloud.glaze-ui.v1.6.human-evidence",
        "goreecloud.glaze-ui.v1.6.assistive-technology-evidence",
        "goreecloud.glaze-ui.v1.6.performance-evidence"
      ]}
    },
    "externalRecordValidator": {"const":"scripts/validate_glaze_v1_6_external_evidence_records.mjs"},
    "currentDispositionWithoutExternalEvidence": {
      "type":"object","additionalProperties":false,
      "required":["verifiedCount","unverifiedCount","notApplicableCount","qualificationEvidenceComplete","readyForGovernedQualificationReview","blockingLaneIds"],
      "properties":{
        "verifiedCount":{"const":17},
        "unverifiedCount":{"const":7},
        "notApplicableCount":{"const":0},
        "qualificationEvidenceComplete":{"const":false},
        "readyForGovernedQualificationReview":{"const":false},
        "blockingLaneIds":{
          "type":"array","minItems":7,"maxItems":7,"uniqueItems":true,
          "items":{"enum":["accessibility","keyboard-navigation","assistive-technology","performance","privacy-boundaries","authority-boundaries","representative-rendering"]}
        }
      }
    },
    "authority": {
      "type":"object","additionalProperties":false,
      "required":[
        "externalEvidenceOptionalForEvaluation","externalEvidenceMustBeSeparatelyValidated",
        "missingExternalEvidenceMayInferPass","staleEvidenceMayInferPass","revisionMismatchMayInferPass",
        "qualificationCompletionMayPromoteLifecycleAutomatically","candidateStatusGranted",
        "releaseCandidateStatusGranted","stableStatusGranted","consumerAcceptanceAutomatic",
        "deploymentAcceptanceAutomatic","productionAcceptanceAutomatic"
      ],
      "properties":{
        "externalEvidenceOptionalForEvaluation":{"const":true},
        "externalEvidenceMustBeSeparatelyValidated":{"const":true},
        "missingExternalEvidenceMayInferPass":{"const":false},
        "staleEvidenceMayInferPass":{"const":false},
        "revisionMismatchMayInferPass":{"const":false},
        "qualificationCompletionMayPromoteLifecycleAutomatically":{"const":false},
        "candidateStatusGranted":{"const":false},
        "releaseCandidateStatusGranted":{"const":false},
        "stableStatusGranted":{"const":false},
        "consumerAcceptanceAutomatic":{"const":false},
        "deploymentAcceptanceAutomatic":{"const":false},
        "productionAcceptanceAutomatic":{"const":false}
      }
    },
    "boundary":{"type":"string","minLength":180}
  }
}
