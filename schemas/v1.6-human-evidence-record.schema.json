{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-human-evidence-record.schema.json",
  "title":"Glaze UI V1.6 Human Evidence Record",
  "type":"object","additionalProperties":false,
  "required":["$schema","schemaVersion","recordId","recordType","lifecycle","sourceRevision","acceptanceModelVersion","stableBaseline","review","scenarioResults","laneEvidence","reviewDecision","authority","boundary"],
  "properties":{
    "$schema":{"const":"../schemas/v1.6-human-evidence-record.schema.json"},
    "schemaVersion":{"const":1},
    "recordId":{"const":"goreecloud.glaze-ui.v1.6.human-evidence"},
    "recordType":{"const":"human"},
    "lifecycle":{"const":"DevelopmentQualification"},
    "sourceRevision":{"const":"c7509c79256b04b0aa67cb9dd0737d7588e0ae4a"},
    "acceptanceModelVersion":{"const":"1.6.0-dev.12"},
    "stableBaseline":{"const":"1.5.1"},
    "review":{
      "type":"object","additionalProperties":false,
      "required":["reviewedAt","reviewer","reviewerRole","operatingSystem","runtime","inputMethods","representativeRuntimeConfirmed"],
      "properties":{
        "reviewedAt":{"type":"string","minLength":1},"reviewer":{"type":"string","minLength":1},"reviewerRole":{"type":"string","minLength":1},
        "operatingSystem":{"type":"string","minLength":1},"runtime":{"type":"string","minLength":1},
        "inputMethods":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "representativeRuntimeConfirmed":{"type":"boolean"}
      }
    },
    "scenarioResults":{
      "type":"array","minItems":10,"maxItems":10,"uniqueItems":true,
      "items":{"type":"object","additionalProperties":false,"required":["id","status","finding"],"properties":{
        "id":{"enum":["available-expanded","permission-required","restricted","offline-or-degraded","reduced-motion","large-text","compact-layout","real-keyboard-focus","privacy-minimization","representative-runtime-rendering"]},
        "status":{"enum":["pass","fail"]},"finding":{"type":"string","minLength":1}
      }}
    },
    "laneEvidence":{
      "type":"array","minItems":5,"maxItems":5,
      "items":{"type":"object","additionalProperties":false,"required":["id","verified","revision","evidenceType","reference","finding"],"properties":{
        "id":{"enum":["accessibility","keyboard-navigation","privacy-boundaries","authority-boundaries","representative-rendering"]},
        "verified":{"type":"boolean"},"revision":{"const":"c7509c79256b04b0aa67cb9dd0737d7588e0ae4a"},"evidenceType":{"const":"human"},
        "reference":{"type":"string","minLength":1},"finding":{"type":"string","minLength":1}
      }}
    },
    "reviewDecision":{"enum":["accepted","not-accepted"]},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["humanEvidenceAccepted","assistiveTechnologyEvidenceAccepted","performanceEvidenceAccepted","lifecyclePromotionAutomatic","candidateStatusGranted","releaseCandidateStatusGranted","stableStatusGranted","consumerAcceptanceAutomatic","deploymentAcceptanceAutomatic","productionAcceptanceAutomatic"],
      "properties":{
        "humanEvidenceAccepted":{"type":"boolean"},"assistiveTechnologyEvidenceAccepted":{"const":false},"performanceEvidenceAccepted":{"const":false},
        "lifecyclePromotionAutomatic":{"const":false},"candidateStatusGranted":{"const":false},"releaseCandidateStatusGranted":{"const":false},"stableStatusGranted":{"const":false},
        "consumerAcceptanceAutomatic":{"const":false},"deploymentAcceptanceAutomatic":{"const":false},"productionAcceptanceAutomatic":{"const":false}
      }
    },
    "boundary":{"type":"string","minLength":120}
  }
}
