{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://goreecloud.dev/schemas/glaze-ui/v1.6-experience-governance.schema.json",
  "title":"Glaze UI V1.6 Experience Governance Development Contract",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","schemaVersion","contractId","name","version","lifecycle",
    "stableBaseline","consumerEligible","implementedSpecificationSections",
    "progressiveDisclosure","actionHierarchy","applicationChrome",
    "crossApplicationFamiliarity","tokens","tokenSafety","truthfulPresentation",
    "privacyPreservingAdaptation","localFirstResolution","stablePrimaryActions",
    "calmDefault","beautyWithRestraint","authority","runtimeEntrypoint",
    "developmentAggregateEntrypoint","tokenMap","boundary"
  ],
  "properties":{
    "$schema":{"const":"../../schemas/v1.6-experience-governance.schema.json"},
    "schemaVersion":{"const":1},
    "contractId":{"const":"goreecloud.glaze-ui.v1.6.experience-governance"},
    "name":{"const":"Glaze UI V1.6 Progressive Disclosure, Action, Token, Truth, Privacy, Local-First, Stability, and Restraint Development Contract"},
    "version":{"const":"1.6.0-dev.8"},
    "lifecycle":{"const":"Development"},
    "stableBaseline":{"const":"1.5.1"},
    "consumerEligible":{"const":false},
    "implementedSpecificationSections":{
      "type":"array","minItems":12,"maxItems":12,"uniqueItems":true,
      "items":{"type":"integer","minimum":1,"maximum":100}
    },
    "progressiveDisclosure":{"type":"object","minProperties":4},
    "actionHierarchy":{"type":"object","minProperties":4},
    "applicationChrome":{"type":"object","minProperties":4},
    "crossApplicationFamiliarity":{"type":"object","minProperties":4},
    "tokens":{"type":"object","minProperties":3},
    "tokenSafety":{"type":"object","minProperties":7},
    "truthfulPresentation":{"type":"object","minProperties":5},
    "privacyPreservingAdaptation":{"type":"object","minProperties":4},
    "localFirstResolution":{"type":"object","minProperties":4},
    "stablePrimaryActions":{"type":"object","minProperties":4},
    "calmDefault":{"type":"object","minProperties":7},
    "beautyWithRestraint":{"type":"object","minProperties":5},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":[
        "boundary","itemEssentialityOwnedByApplication","actionImportanceOwnedByApplication",
        "truthOwnedByResponsibleProvider","adaptationSignalsOwnedByCallerOrPlatform",
        "taskReasonOwnedByApplication","consequentialExecutionAutomatic"
      ],
      "properties":{
        "boundary":{"const":"presentation-only"},
        "itemEssentialityOwnedByApplication":{"const":true},
        "actionImportanceOwnedByApplication":{"const":true},
        "truthOwnedByResponsibleProvider":{"const":true},
        "adaptationSignalsOwnedByCallerOrPlatform":{"const":true},
        "taskReasonOwnedByApplication":{"const":true},
        "consequentialExecutionAutomatic":{"const":false}
      }
    },
    "runtimeEntrypoint":{"const":"js/glaze-v1.6-experience-governance.dev.mjs"},
    "developmentAggregateEntrypoint":{"const":"js/glaze-v1.6-development.mjs"},
    "tokenMap":{"const":"tokens/glaze-v1.6-experience-governance.dev.json"},
    "boundary":{"type":"string","minLength":1}
  }
}
