{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-signature-transition-families.schema.json",
  "title": "Glaze UI V1.7 Signature Transition Families Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema","schemaVersion","contractId","name","version","lifecycle","stableBaseline",
    "consumerEligible","planVersion","v12SpecificationSections","dependsOn","familyOrder",
    "familyPolicy","requestPolicy","authority","accessibility","glazeMotionBoundary",
    "acceptanceBoundary","runtimeEntrypoint","developmentAggregateEntrypoint","tokenMap","sourceAuthorities"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/v1.7-signature-transition-families.schema.json"},
    "schemaVersion": {"const": 1},
    "contractId": {"const": "goreecloud.glaze-ui.v1.7.signature-transition-families"},
    "name": {"const": "Glaze UI V1.7 Signature Transition Families Development Contract"},
    "version": {"const": "1.7.0-dev.16"},
    "lifecycle": {"const": "Development"},
    "stableBaseline": {"const": "1.6.0"},
    "consumerEligible": {"const": false},
    "planVersion": {"const": "v1.2"},
    "v12SpecificationSections": {"const": [24]},
    "dependsOn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signatureMotionSystemVersion","signatureMotionPrinciplesVersion","signatureMotionPrinciplesRuntime"],
      "properties": {
        "signatureMotionSystemVersion": {"const": "1.7.0-dev.14"},
        "signatureMotionPrinciplesVersion": {"const": "1.7.0-dev.15"},
        "signatureMotionPrinciplesRuntime": {"const": "js/glaze-v1.7-signature-motion-principles.dev.mjs"}
      }
    },
    "familyOrder": {
      "const": ["Glaze Bloom","Glaze Flow","Glaze Lift","Glaze Veil","Glaze Fold","Glaze Trace","Glaze Settle","Glaze Focus Transfer","Glaze Color Shift","Glaze Material Shift"]
    },
    "familyPolicy": {"type":"object","minProperties":10,"maxProperties":10},
    "requestPolicy": {"type":"object","minProperties":9},
    "authority": {"type":"object","minProperties":14},
    "accessibility": {"type":"object","minProperties":8},
    "glazeMotionBoundary": {"type":"object","minProperties":5},
    "acceptanceBoundary": {"type":"object","minProperties":15},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-signature-transition-families.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
    "tokenMap": {"const":"tokens/glaze-v1.7-signature-transition-families.dev.json"},
    "sourceAuthorities": {"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
