{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.github.io/glaze-ui/schemas/accessibility-resolution.schema.json",
  "title": "GLAZE UI V1.0 Candidate Accessibility Resolution Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "lifecycle",
    "resolutionOrder",
    "preferences",
    "combinationRules",
    "protectedSemantics",
    "testCases",
    "visualReview"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string"},
    "lifecycle": {"const": "candidate"},
    "resolutionOrder": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "preferences": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["source", "effects"],
        "properties": {
          "source": {"type": "string"},
          "effects": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "combinationRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["when", "then"],
        "properties": {
          "when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "then": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "protectedSemantics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "inputs", "expected"],
        "properties": {
          "id": {"type": "string"},
          "inputs": {"type": "object"},
          "expected": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "visualReview": {
      "type": "object",
      "required": ["required", "criteria"],
      "properties": {
        "required": {"const": true},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
