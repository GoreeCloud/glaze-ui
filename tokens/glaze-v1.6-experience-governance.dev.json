{
  "schemaVersion":1,
  "name":"Glaze UI V1.6 Experience Governance Development Semantic Map",
  "version":"1.6.0-dev.8",
  "lifecycle":"Development",
  "stableBaseline":"1.5.1",
  "consumerEligible":false,
  "sourceAuthorities":[
    "tokens/layout.json",
    "tokens/states.json",
    "tokens/semantic-colors.json",
    "tokens/materials.json",
    "tokens/motion.json",
    "tokens/iconography.json",
    "tokens/glaze-v1.6-loading.dev.json",
    "tokens/glaze-v1.6-state-accessibility.dev.json",
    "tokens/glaze-v1.6-focus-motion.dev.json",
    "tokens/glaze-v1.6-material-type-input.dev.json",
    "tokens/glaze-v1.6-resilience-feedback.dev.json",
    "tokens/glaze-v1.6-navigation-status.dev.json",
    "tokens/glaze-v1.6-component-systems.dev.json"
  ],
  "progressiveDisclosure":{
    "essential":"disclosure.essential-always-visible",
    "additional":"disclosure.additional-on-demand",
    "essentialMayBeHidden":false
  },
  "actionHierarchy":{
    "primary":"action.primary",
    "secondary":"action.secondary",
    "tertiary":"action.tertiary",
    "contextual":"action.contextual",
    "destructive":"action.destructive",
    "referenceDominantLimit":1
  },
  "applicationChrome":{
    "application-bar":"chrome.application-bar",
    "side-navigation":"chrome.side-navigation",
    "search":"chrome.search",
    "dialog":"chrome.dialog",
    "menu":"chrome.menu",
    "context-surface":"chrome.context",
    "settings":"chrome.settings",
    "loading":"chrome.loading",
    "error":"chrome.error",
    "notification":"chrome.notification",
    "applicationIdentityMayRedefineCoreBehavior":false
  },
  "semanticTokenCategories":[
    "skeleton","loading","progress","status","surfaces","content-hierarchy",
    "density","motion","focus","elevation","state","typography",
    "transparency","blur","visual-complexity"
  ],
  "protectedTokenDomains":{
    "accessibility":"token.protected.accessibility",
    "security-state":"token.protected.security",
    "privacy-state":"token.protected.privacy",
    "destructive-action":"token.protected.destructive",
    "focus-visibility":"token.protected.focus",
    "minimum-interaction-size":"token.protected.target-size",
    "arbitraryOverrideAllowed":false
  },
  "truthfulPresentation":{
    "capability":"truth.capability",
    "authority":"truth.authority",
    "privacy":"truth.privacy",
    "security":"truth.security",
    "connectivity":"truth.connectivity",
    "availability":"truth.availability",
    "permission":"truth.permission",
    "unverifiedMayUpgradeToPositive":false
  },
  "adaptationSignals":{
    "allowed":[
      "layout-environment","accessibility-profiles","input-mode","form-factor",
      "performance-level","background-complexity","foreground-importance",
      "posture","appearance","density"
    ],
    "prohibited":[
      "personal-content","private-communications","browsing-history",
      "precise-user-behavior","unrelated-application-state"
    ]
  },
  "localFirst":{
    "ordinary-appearance":"local.appearance",
    "accessibility":"local.accessibility",
    "responsive-behavior":"local.responsive",
    "skeleton-loading":"local.skeleton",
    "component-state-rendering":"local.component-state",
    "focus-presentation":"local.focus",
    "semantic-color-resolution":"local.semantic-color",
    "density-resolution":"local.density",
    "remoteProcessingRequired":false
  },
  "stablePrimaryActions":{
    "preserveSurvivingRelativeOrder":true,
    "transientReorderAllowed":false,
    "strongTaskReasonMayPermitRecomposition":true
  },
  "calmDefault":{
    "controlledAnimation":true,
    "intentionalColor":true,
    "clearHierarchy":true,
    "restrainedTransparency":true,
    "purposefulDepth":true,
    "readableTypography":true,
    "continuousDecorativeMotionDefaultAllowed":false
  },
  "effectBenefits":{
    "hierarchy":"effect-benefit.hierarchy",
    "readability":"effect-benefit.readability",
    "interaction-feedback":"effect-benefit.interaction-feedback",
    "continuity":"effect-benefit.continuity",
    "spatial-understanding":"effect-benefit.spatial-understanding",
    "state-comprehension":"effect-benefit.state-comprehension",
    "identity":"effect-benefit.identity",
    "unjustifiedEffectAllowed":false
  },
  "boundaries":{
    "essentialFunctionalityMayBeHidden":false,
    "protectedSemanticOverrideAllowed":false,
    "truthManufacturedByGlaze":false,
    "privateDataCollectedByResolver":false,
    "ordinaryPresentationRequiresRemoteProcessing":false,
    "consequentialExecutionAutomatic":false
  },
  "boundary":"Development semantic mapping only. Stable V1.5.1 values and lifecycle authority remain unchanged; reference hierarchy limits are Development guidance and do not establish Stable production thresholds."
}
