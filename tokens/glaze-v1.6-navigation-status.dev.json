{
  "schemaVersion": 1,
  "name": "Glaze UI V1.6 Search, Navigation, Responsive, Status, and Authority Development Semantic Map",
  "version": "1.6.0-dev.6",
  "lifecycle": "Development",
  "stableBaseline": "1.5.1",
  "consumerEligible": false,
  "sourceAuthorities": [
    "tokens/layout.json",
    "tokens/states.json",
    "tokens/semantic-colors.json",
    "tokens/adaptive-colors.json",
    "tokens/iconography.json",
    "tokens/icon-construction.json",
    "tokens/icon-identity.json",
    "tokens/glaze-v1.2-form-factor.candidate.json",
    "tokens/glaze-v1.3-layout.candidate.json",
    "tokens/glaze-v1.6-state-accessibility.dev.json",
    "tokens/glaze-v1.6-resilience-feedback.dev.json"
  ],
  "searchPhases": {
    "initial":"search.initial",
    "typing":"search.typing",
    "suggestions":"search.suggestions",
    "loading":"search.loading",
    "partial-results":"search.partial-results",
    "results":"search.results",
    "no-results":"search.no-results",
    "offline-results":"search.offline-results",
    "filters":"search.filters",
    "history":"search.history",
    "error":"search.error"
