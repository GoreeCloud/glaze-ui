    "securityTruthCreatedByGlaze":false,
    "capabilityTruthCreatedByGlaze":false,
    "navigationExecutedByGlaze":false,
    "consequentialExecutionAutomatic":false
  },
  "boundary": "Development semantic mapping only. Stable V1.5.1 values and lifecycle authority remain unchanged; inherited historical Candidate/reference sources are provenance inputs only and are not promoted."
}
