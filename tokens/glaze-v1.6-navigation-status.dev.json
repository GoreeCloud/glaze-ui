      "active-filters","query-state","pane-state"
    ]
  },
  "responsive": {
    "environments":[
      "compact","medium","expanded","large-screen",
      "workspace","far-view","wearable","spatial"
    ],
    "widthAloneIsAuthority": false,
    "deviceBrandBreakpointAuthority": false,
    "taskAndAccessibilityMayChangeComposition": true
  },
  "paneStates": {
    "single-pane":"layout.pane.single",
    "dual-pane":"layout.pane.dual",
    "multi-pane":"layout.pane.multi",
    "overlay-pane":"layout.pane.overlay"
  },
  "postureRoles": {
    "folded":"posture.folded",
    "unfolded":"posture.unfolded",
    "tabletop":"posture.tabletop",
    "portrait":"posture.portrait",
    "landscape":"posture.landscape",
    "external-display":"posture.external-display",
    "resized-window":"posture.resized-window",
    "flat":"posture.flat",
    "unknown":"posture.unknown",
    "hardCodedHingeGeometryAllowed":false
  },
  "localization": {
    "directions":["ltr","rtl","mixed"],
    "logicalPropertiesRequired":true,
    "englishLengthAssumptionsAllowed":false,
    "clippingAllowedByDefault":false,
