    "statePriority": [
      "disabled",
      "error",
      "pressed",
      "focus",
      "selected",
      "hover",
      "rest"
    ],
    "stateLayerOpacity": {
      "hover": [0.03, 0.06],
      "pressed": [0.07, 0.12],
      "selected": [0.08, 0.16]
    },
    "semanticRule": "base surface + interaction overlay"
  },
  "surface": {
    "applicationHierarchy": [
      "canvas",
      "surface",
      "raised",
      "glaze",
      "overlay"
    ],
    "systemHierarchy": [
      "workspace",
      "application",
      "system-overlay",
      "system-panel",
      "critical-system"
    ],
    "contentRule": "Solid where you read. Glazed where you interact.",
    "criticalRule": "Higher-priority system layers become progressively more solid and explicit."
  },
  "color": {
    "light": {
      "canvas": "#F5F7FA",
      "base": "#FFFFFF",
