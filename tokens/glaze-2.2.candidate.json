{
  "meta": {
    "name": "Glaze UI 2.2 Candidate Core",
    "version": "2.2.0-candidate.1",
    "status": "candidate",
    "stableBaseline": "2.1.0",
    "consumerEligible": false,
    "format": "GoreeCloud semantic token map v2",
    "sourceContract": "GLAZE_UI_2_2_CANDIDATE.md",
    "scope": "bounded-core-and-system-shell-foundation",
    "principle": "Content stays clear. Controls become spatial. Motion explains change. Color communicates meaning."
  },
  "interaction": {
    "states": [
      "rest",
      "hover",
      "focus",
      "pressed",
      "selected",
      "disabled",
      "loading",
      "error"
