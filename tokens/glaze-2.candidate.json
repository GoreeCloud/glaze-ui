{
  "meta": {
    "name": "Glaze UI",
    "version": "2.0.0",
    "status": "Candidate",
    "designContractStatus": "enforced",
    "stableImplementationBaseline": "1.6.0",
    "effectiveDate": "2026-08-28",
    "governingSentence": "Make interaction feel tangible.",
    "signature": "ergonomic spatial hierarchy + Glaze Material + connected transformation + adaptive expression",
    "productionEligible": false,
    "requiresStablePromotion": true
  },
  "principles": [
    "content-is-solid-interaction-is-glazed",
    "reach-before-decoration",
    "expression-communicates-importance",
    "interfaces-behave-like-connected-objects",
    "comfort-before-density",
    "one-system-many-personalities"
  ],
  "material": {
    "levels": [
      {"level": 0, "name": "Canvas", "role": "main background or workspace"},
      {"level": 1, "name": "Surface", "role": "cards lists and content containers"},
      {"level": 2, "name": "Soft Glaze", "role": "persistent navigation and secondary controls"},
      {"level": 3, "name": "Glaze", "role": "floating controls and navigation"},
      {"level": 4, "name": "Deep Glaze", "role": "menus expanded controls and popovers"},
      {"level": 5, "name": "Live Glaze", "role": "actively manipulated focused hovered dragged resized spoken-to or dynamic surfaces"}
    ],
    "semanticRoles": ["material.glaze.soft", "material.glaze.standard", "material.glaze.deep", "material.glaze.live"],
    "opticalInputs": ["background-complexity", "contrast-preference", "clarity-preference", "component-scale", "interaction-point", "movement"],
    "clarityModes": ["clear", "balanced", "solid"],
    "readabilityOverridesEffect": true,
    "contentDefaultsToSolidSurface": true
  },
  "geometry": {
    "radiusScalePx": [4, 8, 12, 16, 24, 32],
    "heroRadius": "50%",
    "capsuleRadiusPx": 999,
    "families": {
      "utility": ["rounded-rectangle", "capsule", "circle", "sheet", "panel"],
      "expression": ["organic", "asymmetric", "morphable", "geometric-composition", "animated-silhouette"]
    },
    "concentric": true
  },
  "color": {
    "architecture": ["foundation", "identity", "ambient"],
    "foundationRoles": ["canvas", "surface", "surface-raised", "surface-sunken", "border", "text-primary", "text-secondary", "text-muted"],
    "identityRoles": ["accent", "accent-soft", "accent-container", "accent-strong", "accent-contrast"],
    "identitySource": "accent-seed",
    "ambientIsSemantic": false,
    "rule": "Color the content freely. Tint the chrome selectively."
  },
  "appearance": {
    "modes": ["light", "dark", "deep-dark"],
    "darkIsSimpleInversion": false
  },
  "type": {
    "preferVariableTypeface": true,
    "remoteRuntimeFontRequired": false,
    "scale": {
      "display-xl": [64, 72],
      "display": [48, 56],
      "headline-xl": [36, 40],
      "headline": [28, 32],
      "title": [22, 24],
      "body-large": 18,
      "body": 16,
      "label": 14,
      "caption": 12
    }
  },
  "space": {
    "baseGridPx": 4,
    "scalePx": [4, 8, 12, 16, 24, 32, 48, 64]
  },
  "layout": {
    "mobileZones": ["viewing", "working", "glaze-action"],
    "transformRatherThanResize": true,
    "navigationTransform": {
      "phone": "bottom-floating-capsule",
      "tablet": "navigation-rail",
      "desktop": "sidebar",
      "television": "focus-driven-dock",
      "wearable": "compact-rotational-navigation",
      "spatial": "floating-control-surface"
    },
    "foldableFirstClass": true,
    "hingeAware": true
  },
  "navigationCapsule": {
    "phonePrimaryPattern": true,
    "selectedDestinationMayExpand": true,
    "forwardReadingCompresses": true,
    "reverseScrollExpands": true
  },
  "buttons": {
    "roles": ["quiet", "soft", "glaze", "emphasis"],
    "emphasisScarce": true,
    "pressedBehavior": ["contract", "pull-highlight-to-interaction", "increase-optical-density", "optional-haptic", "spring-return"]
  },
  "cards": {
    "levels": ["flat", "tonal", "raised", "interactive-glaze"],
    "containOnlyWhenContainmentCommunicates": true,
    "nestedCardsUncommon": true
  },
  "motion": {
    "noTeleport": true,
    "preferSpringsForPhysicalInteraction": true,
    "families": {
      "utilityMs": [100, 180],
      "fluidMs": [180, 400],
      "expressiveMs": [400, 700]
    },
    "implementationAliasesMs": {
      "fast": 140,
      "standard": 280,
      "expressive": 520
    },
    "verbs": ["expand", "contract", "merge", "split", "flow", "spring", "follow", "settle"]
  },
  "connectedTransformation": {
    "signaturePattern": true,
    "preserveSpatialContinuity": true,
    "nativeSharedElementPreferred": true,
    "statePreservingFallbackRequired": true
  },
  "haptic": {
    "tap": "tiny-pulse",
    "toggle": "snap",
    "selection": "tick",
    "drag-threshold": "notch",
    "drop": "cushioned-bump",
    "error": "restrained-double-pulse",
    "success": "soft-confirmation",
    "essentialMeaningAllowed": false
  },
  "intelligence": {
    "presentationModes": ["ambient", "assisted", "conversational", "agentic"],
    "obligatoryGlowingGradient": false,
    "presentationOnly": true,
    "createsExecutionAuthority": false,
    "createsDomainTruth": false
  },
  "liveSurface": {
    "processes": ["upload", "navigation", "timer", "delivery", "generation", "recording", "call", "media-playback", "download", "synchronization", "transfer"],
    "crossContextContinuity": true
  },
  "accessibility": {
    "reducedTransparency": "increase-opacity",
    "increasedContrast": "strengthen-boundaries-and-separation",
    "reducedMotion": "simplify-morphing-to-shorter-fades-or-restrained-position",
    "largeText": "reorganize-without-clipping",
    "colorIndependence": true,
    "showBoundaries": "explicit-interactive-outlines",
    "touchAssistance": "increase-effective-hit-area",
    "usableWithoutAdvancedEffects": true
  },
  "personalization": {
    "appearance": ["light", "dark", "deep-dark"],
    "color": "accent-seed",
    "expression": ["calm", "balanced", "expressive"],
    "defaultExpression": "balanced"
  },
  "componentFamilies": {
    "foundations": ["color", "typography", "spacing", "shape", "material", "elevation", "grid", "iconography"],
    "actions": ["button", "icon-button", "floating-action-control", "split-button", "button-group"],
    "inputs": ["text-field", "search-field", "slider", "toggle", "checkbox", "radio-control", "picker"],
    "navigation": ["navigation-capsule", "navigation-rail", "sidebar", "breadcrumbs", "tabs"],
    "containers": ["surface", "card", "glaze-panel", "sheet", "dialog", "popover"],
    "communication": ["toast", "banner", "notification", "badge", "tooltip"],
    "live": ["live-surface", "progress-surface", "media-controller", "activity-chip"],
    "selection": ["chip", "segmented-control", "selection-bar"],
    "data": ["list", "table", "chart", "timeline", "metric-surface"],
    "intelligence": ["prompt-field", "assist-surface", "generation-state", "source-surface", "agent-activity"],
    "spatial": ["floating-toolbar", "control-volume", "environmental-panel", "anchored-surface"]
  },
  "tokenNamespaces": [
    "glaze.color.*", "glaze.type.*", "glaze.space.*", "glaze.shape.*", "glaze.material.*", "glaze.motion.*", "glaze.depth.*", "glaze.opacity.*", "glaze.blur.*", "glaze.border.*", "glaze.haptic.*", "glaze.layout.*", "glaze.state.*"
  ],
  "webAliases": {
    "--glaze-shape-control": "999px",
    "--glaze-shape-card": "24px",
    "--glaze-space-xs": "4px",
    "--glaze-space-sm": "8px",
    "--glaze-space-md": "16px",
    "--glaze-space-lg": "24px",
    "--glaze-space-xl": "32px",
    "--glaze-motion-fast": "140ms",
    "--glaze-motion-standard": "280ms",
    "--glaze-motion-expressive": "520ms",
    "--glaze-touch-min": "48px"
  },
  "antiPatterns": [
    "glass-everywhere",
    "giant-radius-everywhere",
    "decorative-intelligence-gradient",
    "meaningless-animation",
    "endlessly-nested-cards",
    "tiny-desktop-controls",
    "unreadable-transparency",
    "uncontrolled-accent-color",
    "effects-required-for-basic-usability",
    "motion-that-obscures-spatial-relationships"
  ]
}
