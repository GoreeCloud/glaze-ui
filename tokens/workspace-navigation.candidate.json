{
  "meta": {
    "name": "Glaze UI Adaptive Workspace and Navigation",
    "candidateVersion": "1.6.0",
    "status": "Stable",
    "stableBaseline": "1.6.0",
    "principle": "Content remains primary while window chrome, navigation, tools, and inspectors adapt to form factor, input, density, and accessibility without changing semantic order or producer-authoritative state.",
    "releaseVersion": "1.6.0"
  },
  "regions": {
    "window": {
      "role": "application workspace boundary",
      "layer": "base"
    },
    "title": {
      "role": "title, document identity, drag area, platform window affordances",
      "layer": "navigation"
    },
    "navigation": {
      "role": "primary destinations",
      "layer": "navigation"
    },
    "toolbar": {
      "role": "frequent and contextual actions",
      "layer": "navigation"
    },
    "content": {
      "role": "primary task and information",
      "layer": "content"
    },
    "inspector": {
      "role": "contextual properties and secondary tools",
      "layer": "raised"
    },
    "status": {
      "role": "persistent subordinate system or workflow status",
      "layer": "raised"
    },
    "overlay": {
      "role": "menus, popovers, dialogs, sheets, temporary controls",
      "layer": "overlay"
    }
  },
  "sizing": {
    "sidebar": {
      "compact": 72,
      "standard": 260,
      "wide": 304,
      "minResizable": 220,
      "maxResizable": 360
    },
    "inspector": {
      "standard": 320,
      "wide": 376,
      "minResizable": 280,
      "maxResizable": 480
    },
    "toolbar": {
      "compact": 48,
      "standard": 56,
      "touch": 64
    },
    "titleRegion": {
      "compact": 44,
      "standard": 52
    }
  },
  "targets": {
    "precisionPointerMinimum": 40,
    "mixedInputMinimum": 44,
    "coarsePointerMinimum": 48,
    "tvMinimum": 56,
    "rule": "Compact visual padding may not shrink the interactive hit region below the applicable input floor."
  },
  "density": {
    "comfortable": {
      "gap": 12,
      "regionGap": 20,
      "controlPaddingInline": 16
    },
    "compact": {
      "gap": 8,
      "regionGap": 16,
      "controlPaddingInline": 12
    },
    "spacious": {
      "gap": 16,
      "regionGap": 28,
      "controlPaddingInline": 20
    }
  },
  "geometry": {
    "windowRadius": 24,
    "regionRadius": 20,
    "panelRadius": 16,
    "controlRadius": 14,
    "nestedRule": "Nested surfaces should generally use proportionally smaller radii than their parent region."
  },
  "navigationTransform": {
    "mobile": {
      "primary": "top-or-bottom-navigation",
      "sidebar": "overlay-or-sheet",
      "inspector": "sheet-or-panel",
      "toolbar": "compact-with-overflow"
    },
    "tablet": {
      "primary": "adaptive-sidebar-or-rail",
      "sidebar": "persistent-or-overlay",
      "inspector": "collapsible-panel",
      "toolbar": "touch-first-adaptive"
    },
    "desktop": {
      "primary": "persistent-sidebar-or-rail",
      "sidebar": "persistent-resizable",
      "inspector": "persistent-or-collapsible-resizable",
      "toolbar": "persistent-with-overflow"
    },
    "tv": {
      "primary": "directional-focus-groups",
      "sidebar": "focusable-rail-or-horizontal-navigation",
      "inspector": "context-panel-if-far-view-safe",
      "toolbar": "bounded-focusable-actions"
    }
  },
  "materials": {
    "contentDefault": [
      "Solid",
      "Raised"
    ],
    "chromePreferred": [
      "Functional Glass",
      "Solid"
    ],
    "overlay": "Overlay",
    "reducedTransparencyFallback": "Solid",
    "rule": "Functional Glass supports navigation and controls; primary reading surfaces remain stable and readable."
  },
  "adaptation": {
    "sidebarToOverlay": true,
    "inspectorToSheet": true,
    "toolbarToOverflow": true,
    "multiColumnToSingleColumn": true,
    "preserveSemanticOrder": true,
    "preserveFocusOrder": true,
    "preserveCurrentDestination": true,
    "preserveActionState": true
  },
  "accessibility": {
    "focusVisible": true,
    "iconOnlyAccessibleName": true,
    "reducedMotion": true,
    "reducedTransparency": true,
    "forcedColors": true,
    "keyboardDesktopWeb": true,
    "noHoverOnlyPrimaryAction": true,
    "nonColorStateCue": true
  },
  "authority": {
    "presentationOnly": true,
    "privacy": "Privacy Shield",
    "security": "Wardveil Security",
    "continuity": "Everkeep",
    "coordination": "GoreeCloud Mesh",
    "applicationState": "application logic",
    "rule": "Workspace prominence, color, material, or placement cannot invent or upgrade producer-authoritative truth."
  }
}
