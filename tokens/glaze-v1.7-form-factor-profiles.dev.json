      "overlayBehavior":"overlay.posture-aware",
      "targets":"target.touch-floor"
    },
    "tv": {
      "navigation":"navigation.directional-focus",
      "reachability":"reachability.far-view",
      "density":"density.comfortable",
      "viewingDistance":"viewing.far",
      "paneBehavior":"pane.large-task-dependent",
      "overlayBehavior":"overlay.far-view-panel-or-dialog",
      "targets":"target.far-view-floor"
    },
    "wearable": {
      "navigation":"navigation.shallow-glanceable",
      "reachability":"reachability.single-focus",
      "density":"density.comfortable",
      "viewingDistance":"viewing.near-glance",
      "paneBehavior":"pane.single",
      "overlayBehavior":"overlay.full-screen-or-native",
      "targets":"target.wearable-platform-floor"
    }
