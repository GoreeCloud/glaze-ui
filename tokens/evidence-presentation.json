{
  "glaze_ui": {
    "candidate": "1.6",
    "lifecycle": "stable",
    "stable_consumer_target": "1.6.0",
    "release": "1.6.0"
  },
  "contract": "evidence-presentation",
  "authority_systems": {
    "wardveil-security": {
      "domains": [
        "security"
      ],
      "presentation_role": "security-authority"
    },
    "privacy-shield": {
      "domains": [
        "privacy"
      ],
      "presentation_role": "privacy-authority"
    },
    "everkeep": {
      "domains": [
        "resilience",
        "recovery",
        "preservation",
        "continuity"
      ],
      "presentation_role": "resilience-authority"
    },
    "goreecloud-mesh": {
      "domains": [
        "coordination",
        "governance"
      ],
      "presentation_role": "coordination-authority"
    },
    "glaze-ui": {
      "domains": [
        "presentation",
        "design-conformance"
      ],
      "presentation_role": "presentation-authority"
    }
  },
  "freshness_states": {
    "current": {
      "meaning": "Evidence is inside the producer-declared validity window.",
      "positive_domain_truth": false
    },
    "stale": {
      "meaning": "Evidence requires refresh under the producer contract.",
      "positive_domain_truth": false
    },
    "expired": {
      "meaning": "The producer-declared validity window has ended.",
      "positive_domain_truth": false
    },
    "unknown": {
      "meaning": "Evidence freshness cannot be established.",
      "positive_domain_truth": false
    }
  },
  "transport_states": {
    "available": {
      "meaning": "Transport/envelope metadata is available and structurally usable.",
      "positive_domain_truth": false
    },
    "unavailable": {
      "meaning": "Transport or source evidence is currently unavailable.",
      "positive_domain_truth": false
    },
    "invalid": {
      "meaning": "Envelope provenance, authority, minimization, or validation failed.",
      "positive_domain_truth": false
    }
  },
  "surface_roles": {
    "evidence-summary": {
      "required_semantics": [
        "producer-state",
        "scope"
      ],
      "recommended_semantics": [
        "authority",
        "freshness",
        "reason"
      ]
    },
    "evidence-detail": {
      "required_semantics": [
        "producer-state",
        "scope",
        "authority",
        "freshness",
        "source-detail"
      ]
    },
    "evidence-authority": {
      "required_semantics": [
        "authority"
      ]
    },
    "evidence-freshness": {
      "required_semantics": [
        "freshness"
      ],
      "must_not_imply_success": true
    },
    "evidence-action": {
      "required_semantics": [
        "producer-authorized-action"
      ]
    }
  },
  "material_guidance": {
    "ordinary": [
      "solid",
      "raised"
    ],
    "contextual": [
      "functional-glass",
      "overlay"
    ],
    "critical_dense_text_clear_glass": "prohibited"
  },
  "accessibility": {
    "color_only_state": "prohibited",
    "icon_only_state": "prohibited",
    "motion_only_state": "prohibited",
    "authority_exposed_to_accessibility_tree": true,
    "freshness_exposed_to_accessibility_tree": true,
    "producer_state_exposed_to_accessibility_tree": true
  },
  "invariants": [
    "Glaze UI presents supplied evidence and never creates evidence.",
    "Freshness cannot be styled as positive domain truth by itself.",
    "Transport availability cannot be styled as security, privacy, recovery, or conformance success.",
    "Producer authority domains cannot be merged into a generic safe/protected state.",
    "System identity artwork never independently proves implementation or acceptance.",
    "Missing, invalid, stale, unsupported, or unavailable evidence must not resolve to success."
  ]
