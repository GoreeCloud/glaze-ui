{
  "schema_version": "1.0.0",
  "system": "glaze-ui",
  "producer_repository": "GoreeCloud/glaze-ui",
  "authority_domains": [
    "presentation",
    "design-conformance"
  ],
  "mesh_envelope": {
    "version": "goreecloud.evidence-envelope.v1",
