{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "glaze": {
    "wearableCandidate": {
      "status": {"$type": "string", "$value": "development-candidate"},
      "target": {
        "minimumWearOs": {"$type": "dimension", "$value": {"value": 48, "unit": "dp"}},
        "comfortable": {"$type": "dimension", "$value": {"value": 52, "unit": "dp"}}
      },
      "spacing": {
        "contentEdgeCompact": {"$type": "dimension", "$value": {"value": 12, "unit": "dp"}},
        "controlGap": {"$type": "dimension", "$value": {"value": 8, "unit": "dp"}},
        "safeEdgeRound": {"$type": "dimension", "$value": {"value": 16, "unit": "dp"}}
      },
      "motion": {
        "fast": {"$type": "duration", "$value": {"value": 120, "unit": "ms"}},
        "standard": {"$type": "duration", "$value": {"value": 180, "unit": "ms"}},
        "emphasizedMaximum": {"$type": "duration", "$value": {"value": 260, "unit": "ms"}}
      },
      "surface": {
        "glance": {"$type": "string", "$value": "single-priority-state"},
        "task": {"$type": "string", "$value": "focused-short-session"},
        "hosted": {"$type": "string", "$value": "platform-constrained"},
        "ambient": {"$type": "string", "$value": "reduced-decoration-and-refresh"}
      },
      "input": {
        "primary": {"$type": "string", "$value": "touch-or-native-equivalent"},
        "rotary": {"$type": "string", "$value": "optional-first-class-enhancement"},
        "rotaryUse": {"$type": "string", "$value": "scroll-select-adjust"}
      },
      "resilience": {
        "reducedMotion": {"$type": "boolean", "$value": true},
        "reducedTransparency": {"$type": "boolean", "$value": true},
        "solidFallback": {"$type": "boolean", "$value": true},
        "largeText": {"$type": "boolean", "$value": true}
      }
    }
  }
}
