{
  "$schema": "../../schemas/v1.7-signature-transition-families.schema.json",
  "schemaVersion": 1,
  "contractId": "goreecloud.glaze-ui.v1.7.signature-transition-families",
  "name": "Glaze UI V1.7 Signature Transition Families Development Contract",
  "version": "1.7.0-dev.16",
  "lifecycle": "Development",
  "stableBaseline": "1.6.0",
  "consumerEligible": false,
  "planVersion": "v1.2",
  "v12SpecificationSections": [24],
  "dependsOn": {
    "signatureMotionSystemVersion": "1.7.0-dev.14",
    "signatureMotionPrinciplesVersion": "1.7.0-dev.15",
    "signatureMotionPrinciplesRuntime": "js/glaze-v1.7-signature-motion-principles.dev.mjs"
  },
  "familyOrder": [
    "Glaze Bloom",
    "Glaze Flow",
    "Glaze Lift",
    "Glaze Veil",
    "Glaze Fold",
    "Glaze Trace",
    "Glaze Settle",
    "Glaze Focus Transfer",
    "Glaze Color Shift",
    "Glaze Material Shift"
  ],
  "familyPolicy": {
    "Glaze Bloom": {
      "relationship": "same-object-expansion",
      "intent": "same-thing-expanded",
      "channels": ["shape", "position", "material", "content-hierarchy"],
      "requiresObjectIdentityAuthority": true,
      "reducedMotionEquivalent": "state-preserving-crossfade"
    },
    "Glaze Flow": {
      "relationship": "workspace-recomposition",
      "intent": "workspace-changed-task-preserved",
      "channels": ["position", "pane-geometry", "hierarchy"],
      "requiresObjectIdentityAuthority": false,
      "reducedMotionEquivalent": "instant-recomposition-with-focus-continuity"
    },
    "Glaze Lift": {
      "relationship": "transient-elevation",
      "intent": "transient-hierarchy-emerged",
      "channels": ["depth", "material", "opacity", "position"],
      "requiresObjectIdentityAuthority": false,
      "reducedMotionEquivalent": "opacity-and-hierarchy-state"
    },
    "Glaze Veil": {
      "relationship": "context-overlay",
      "intent": "context-remains-attention-moved-above",
      "channels": ["scrim", "foreground-material", "hierarchy", "opacity"],
      "requiresObjectIdentityAuthority": false,
      "criticalSurfaceTranslucencyRequired": false,
      "reducedMotionEquivalent": "immediate-hierarchy-with-restrained-opacity"
    },
    "Glaze Fold": {
      "relationship": "posture-partition",
      "intent": "workspace-partition-changed",
      "channels": ["pane-geometry", "position", "hierarchy"],
      "requiresObjectIdentityAuthority": false,
      "literalFoldSimulationAllowed": false,
      "reducedMotionEquivalent": "instant-partition-with-task-continuity"
    },
    "Glaze Trace": {
      "relationship": "source-destination-continuity",
      "intent": "source-connected-to-destination",
      "channels": ["position", "highlight", "material", "edge-emphasis"],
      "requiresObjectIdentityAuthority": true,
      "continuousDecorativeTrailAllowed": false,
      "reducedMotionEquivalent": "source-destination-emphasis"
    },
    "Glaze Settle": {
      "relationship": "direct-manipulation-settle",
      "intent": "manipulation-resolved-precisely",
      "channels": ["position", "geometry"],
      "requiresObjectIdentityAuthority": false,
      "routineBounceAllowed": false,
      "reducedMotionEquivalent": "direct-tracking-then-immediate-rest"
    },
    "Glaze Focus Transfer": {
      "relationship": "focus-transfer",
      "intent": "focus-moved-between-related-regions",
      "channels": ["focus-emphasis", "edge-emphasis", "material"],
      "requiresObjectIdentityAuthority": false,
      "focusStateIndependentOfAnimation": true,
      "reducedMotionEquivalent": "immediate-focus-state-with-emphasis"
    },
    "Glaze Color Shift": {
      "relationship": "color-state-change",
      "intent": "color-context-changed-coherently",
      "channels": ["semantic-color", "accent", "atmosphere"],
      "requiresObjectIdentityAuthority": false,
      "protectedSemanticMeaningImmediate": true,
      "reducedMotionEquivalent": "immediate-semantic-color-with-optional-restrained-fade"
    },
    "Glaze Material Shift": {
      "relationship": "material-role-change",
      "intent": "surface-material-role-changed",
      "channels": ["material", "tint", "border", "luminosity", "depth"],
      "requiresObjectIdentityAuthority": false,
      "reducedTransparencySolidEquivalent": true,
      "reducedMotionEquivalent": "immediate-material-role-state"
    }
  },
  "requestPolicy": {
    "semanticRelationshipRequired": true,
    "directFamilyRequestAccepted": false,
    "rawDurationAccepted": false,
    "rawEasingAccepted": false,
    "rawSpringAccepted": false,
    "rawKeyframesAccepted": false,
    "rawPathAccepted": false,
    "rawDistanceAccepted": false,
    "rawRotationAccepted": false
  },
  "authority": {
