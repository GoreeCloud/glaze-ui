{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goreecloud:glaze-ui:v1.4:performance-qualification-evidence:candidate:v1",
  "title": "Glaze UI V1.4 Performance Qualification Evidence Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateVersion",
    "sourceRevision",
    "sourceTreeRevision",
    "platformFamily",
    "environment",
    "measuredAt",
    "metrics",
    "evidenceRefs",
    "reviewer",
    "result",
    "lifecycleAcceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "glaze.v1.4.performance-qualification-evidence.candidate.v1"
    },
    "candidateVersion": {
      "const": "1.4.0-candidate"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceTreeRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platformFamily": {
      "enum": ["web", "android", "ios", "linux", "windows", "macos", "chromeos", "other"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "renderer", "deviceClass"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1, "maxLength": 160},
        "renderer": {"type": "string", "minLength": 1, "maxLength": 160},
        "deviceClass": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "measured", "budget", "sampleCount", "accepted"],
        "properties": {
          "name": {
            "enum": [
              "startup_ms",
              "runtime_init_ms",
              "stylesheet_parse_ms",
              "first_interaction_ms",
              "interaction_latency_p95_ms",
              "frame_p95_ms",
              "frame_p99_ms",
              "memory_peak_mib"
            ]
          },
          "unit": {"enum": ["ms", "MiB"]},
          "measured": {"type": "number", "minimum": 0},
          "budget": {"type": "number", "exclusiveMinimum": 0},
          "sampleCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "accepted": {"type": "boolean"}
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,175}$",
        "minLength": 82,
        "maxLength": 256
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "authorityEvidence", "reviewEvidence", "reviewedAt", "disposition", "rationale"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 200},
        "authorityEvidence": {
          "type": "string",
          "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,175}$",
          "minLength": 82,
          "maxLength": 256
        },
        "reviewEvidence": {
          "type": "string",
          "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,175}$",
          "minLength": 82,
          "maxLength": 256
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "disposition": {"enum": ["pending", "accepted", "rejected"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "result": {
      "enum": ["blocked", "passed", "failed"]
    },
    "lifecycleAcceptance": {
      "const": false
    }
  }
}
