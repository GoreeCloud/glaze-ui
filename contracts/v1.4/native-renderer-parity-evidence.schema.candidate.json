{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goreecloud:glaze-ui:v1.4:native-renderer-parity-evidence:candidate:v1",
  "title": "Glaze UI V1.4 Native Renderer Parity Evidence Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateVersion", "sourceRevision", "sourceTreeRevision",
    "platformFamily", "environment", "capturedAt", "comparisonContract",
    "scenes", "reviewer", "result", "lifecycleAcceptance"
  ],
  "properties": {
    "schemaVersion": {"const": "glaze.v1.4.native-renderer-parity-evidence.candidate.v1"},
    "candidateVersion": {"const": "1.4.0-candidate"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceTreeRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platformFamily": {"enum": ["android", "ios", "linux", "windows", "macos", "chromeos", "other"]},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "nativeRenderer", "referenceRenderer", "deviceClass", "osVersion"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1, "maxLength": 160},
        "nativeRenderer": {"type": "string", "minLength": 1, "maxLength": 160},
        "referenceRenderer": {"type": "string", "minLength": 1, "maxLength": 160},
        "deviceClass": {"type": "string", "minLength": 1, "maxLength": 160},
        "osVersion": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "capturedAt": {"type": "string", "format": "date-time", "maxLength": 40},
    "comparisonContract": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "method", "acceptanceCriteria"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 200},
        "method": {"type": "string", "minLength": 1, "maxLength": 500},
        "acceptanceCriteria": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "referenceEvidence", "nativeEvidence", "disposition", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
          "referenceEvidence": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,175}$", "minLength": 82, "maxLength": 256},
          "nativeEvidence": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,175}$", "minLength": 82, "maxLength": 256},
          "disposition": {"enum": ["pending", "accepted", "rejected"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "disposition", "rationale"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 200},
        "disposition": {"enum": ["pending", "accepted", "rejected"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "result": {"enum": ["blocked", "passed", "failed"]},
    "lifecycleAcceptance": {"const": false}
  }
}
