{
  "$schema":"../../schemas/v1.6-experience-governance.schema.json",
  "schemaVersion":1,
  "contractId":"goreecloud.glaze-ui.v1.6.experience-governance",
  "name":"Glaze UI V1.6 Progressive Disclosure, Action, Token, Truth, Privacy, Local-First, Stability, and Restraint Development Contract",
  "version":"1.6.0-dev.8",
  "lifecycle":"Development",
  "stableBaseline":"1.5.1",
  "consumerEligible":false,
  "implementedSpecificationSections":[74,75,76,77,78,79,88,89,90,91,92,93],
  "progressiveDisclosure":{
    "importantInformationFirst":true,
    "additionalControlsMayBeRevealedOnDemand":true,
    "essentialFunctionalityMayBeHidden":false,
    "mayEraseTaskState":false
  },
  "actionHierarchy":{
    "classes":["primary","secondary","tertiary","contextual","destructive"],
    "referenceSimultaneousDominantLimit":1,
    "destructiveSemanticProtectionRequired":true,
    "tertiaryAndContextualRemainSubordinate":true
  },
  "applicationChrome":{
    "surfaces":[
      "application-bar","side-navigation","search","dialog","menu",
      "context-surface","settings","loading","error","notification"
    ],
    "sharedFocusAndKeyboardSemantics":true,
    "sharedLoadingErrorNotificationSemantics":true,
    "applicationIdentityMayRedefineCoreBehavior":false
  },
  "crossApplicationFamiliarity":{
    "operations":[
      "create","save","search","filter","select","open","close",
      "back","refresh","retry","share","delete","settings"
    ],
    "equivalentInteractionsRemainFamiliar":true,
    "arbitraryBehaviorChangesAllowed":false,
    "presentationVariationAllowed":true
  },
  "tokens":{
    "categories":[
      "skeleton","loading","progress","status","surfaces","content-hierarchy",
      "density","motion","focus","elevation","state","typography",
      "transparency","blur","visual-complexity"
    ],
    "semanticTokensRequired":true,
    "rawValueDuplicationPreferred":false
  },
  "tokenSafety":{
    "protectedDomains":[
      "accessibility","security-state","privacy-state",
      "destructive-action","focus-visibility","minimum-interaction-size"
    ],
    "protectedSemanticOverrideAllowed":false,
    "accessibilityMayBeBrokenByOverride":false,
    "securityMeaningMayBeRedefined":false,
    "privacyMeaningMayBeRedefined":false,
    "destructiveMeaningMayBeRedefined":false,
    "focusVisibilityMayBeSuppressed":false,
    "minimumInteractionSizeMayBeReduced":false
  },
  "truthfulPresentation":{
    "kinds":["capability","authority","privacy","security","connectivity","availability","permission"],
    "specificTruthWithoutAuthorityAllowed":false,
    "failClosedWhenUnverified":true,
    "stateManufacturedByGlaze":false,
    "permissionGrantedByGlaze":false
  },
  "privacyPreservingAdaptation":{
    "allowedSignals":[
      "layout-environment","accessibility-profiles","input-mode","form-factor",
      "performance-level","background-complexity","foreground-importance",
      "posture","appearance","density"
    ],
    "prohibitedSignals":[
      "personal-content","private-communications","browsing-history",
      "precise-user-behavior","unrelated-application-state"
    ],
    "minimumNecessarySignalsOnly":true,
    "privateDataCollectedByResolver":false
  },
  "localFirstResolution":{
    "capabilities":[
      "ordinary-appearance","accessibility","responsive-behavior",
      "skeleton-loading","component-state-rendering","focus-presentation",
      "semantic-color-resolution","density-resolution"
    ],
    "remoteProcessingRequired":false,
    "networkAvailabilityRequired":false,
    "safeLocalFallbackRequired":true
  },
  "stablePrimaryActions":{
    "transientAdaptationMayReorder":false,
    "survivingRelativeOrderPreserved":true,
    "strongTaskReasonMayPermitRecomposition":true,
    "spatialPredictabilityRequired":true
  },
  "calmDefault":{
    "controlledAnimationRequired":true,
    "intentionalColorRequired":true,
    "clearHierarchyRequired":true,
    "restrainedTransparencyRequired":true,
    "purposefulDepthRequired":true,
    "readableTypographyRequired":true,
    "continuousDecorativeMotionDefaultAllowed":false
  },
  "beautyWithRestraint":{
    "effects":[
      "color","translucency","blur","reflection","depth","motion","environmental-adaptation"
    ],
    "approvedBenefits":[
      "hierarchy","readability","interaction-feedback","continuity",
      "spatial-understanding","state-comprehension","identity"
    ],
    "effectMustImproveApprovedOutcome":true,
    "visualIntensityEqualsQuality":false,
    "unjustifiedEffectAllowed":false
  },
  "authority":{
    "boundary":"presentation-only",
    "itemEssentialityOwnedByApplication":true,
    "actionImportanceOwnedByApplication":true,
    "truthOwnedByResponsibleProvider":true,
    "adaptationSignalsOwnedByCallerOrPlatform":true,
    "taskReasonOwnedByApplication":true,
    "consequentialExecutionAutomatic":false
  },
  "runtimeEntrypoint":"js/glaze-v1.6-experience-governance.dev.mjs",
  "developmentAggregateEntrypoint":"js/glaze-v1.6-development.mjs",
  "tokenMap":"tokens/glaze-v1.6-experience-governance.dev.json",
  "boundary":"Development implementation foundation only. It does not alter VERSION, registry lifecycle authority, V1.5.1 Stable contracts, consumer eligibility, downstream acceptance, release publication, deployment, or production state."
}
