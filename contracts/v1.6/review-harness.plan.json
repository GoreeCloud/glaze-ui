{
  "$schema":"../../schemas/v1.6-review-harness-plan.schema.json",
  "schemaVersion":1,
  "planId":"goreecloud.glaze-ui.v1.6.review-harness",
  "name":"Glaze UI V1.6 Human, Rendered, Accessibility, and Performance Review Harness Plan",
  "lifecycle":"DevelopmentQualification",
  "sourceRevision":"c7509c79256b04b0aa67cb9dd0737d7588e0ae4a",
  "acceptanceModelVersion":"1.6.0-dev.12",
  "stableBaseline":"1.5.1",
  "consumerEligible":false,
  "humanHarness":"reference/v1.6/human-review.html",
  "performanceHarness":"reference/v1.6/performance-qualification.html",
  "reviewRecordTemplate":"acceptance/v1.6-review-record.template.json",
  "networkPolicy":"repository-local-only",
  "automaticAcceptance":false,
  "automaticPromotionEligibility":false,
  "requiredReviewLanes":[
    "accessibility",
    "reduced-motion",
    "reduced-transparency",
    "increased-contrast",
    "large-text",
    "keyboard-navigation",
    "assistive-technology",
    "responsive-layouts",
    "form-factor-transitions",
    "performance",
    "layout-stability",
    "privacy-boundaries",
    "authority-boundaries",
    "regression-testing",
    "representative-rendering"
  ],
  "humanReviewScenarios":[
    "appearance-light",
    "appearance-dark",
    "increased-contrast",
    "reduced-motion",
    "reduced-transparency",
    "large-text-200-percent",
    "keyboard-focus",
    "loading",
    "empty",
    "error",
    "offline",
    "degraded",
    "privacy-private",
    "privacy-restricted",
    "security-protected",
    "security-warning",
    "compact-layout",
    "workspace-layout"
  ],
  "performanceMinimumSamples":{
    "resolverWarmup":20,
    "resolverMeasured":200,
    "interactionToPaint":30,
    "idleFrameIntervals":120,
    "activeFrameIntervals":240
  },
  "performanceThresholds":{
    "resolverP95MsMax":10.0,
    "resolverP99MsMax":16.7,
    "interactionPaintP95MsMax":100,
    "interactionPaintP99MsMax":200,
    "activeFrameP95Rule":"<= max(20 ms, 1.25 * idle median frame interval)",
    "severeFrameStallRatePercentMax":1.0,
    "catastrophicForegroundStallCountMax":0,
    "taskStateResetMax":0,
    "pageReloadRequiredMax":0,
    "automaticAuthorityActionsMax":0
  },
  "sourceContinuityPaths":[
    "js/glaze-v1.6-development.mjs",
    "js/glaze-v1.6-loading.dev.mjs",
    "js/glaze-v1.6-state-accessibility.dev.mjs",
    "js/glaze-v1.6-focus-motion.dev.mjs",
    "js/glaze-v1.6-material-type-input.dev.mjs",
    "js/glaze-v1.6-resilience-feedback.dev.mjs",
    "js/glaze-v1.6-navigation-status.dev.mjs",
    "js/glaze-v1.6-component-systems.dev.mjs",
    "js/glaze-v1.6-experience-governance.dev.mjs",
    "js/glaze-v1.6-performance-diagnostics.dev.mjs",
    "js/glaze-v1.6-conformance-adoption.dev.mjs",
    "js/glaze-v1.6-acceptance.dev.mjs"
  ],
  "privacy":{
    "remoteTelemetry":false,
    "remoteAnalysis":false,
    "credentialsRecorded":false,
    "providerSecretsRecorded":false,
    "rawTaskContentRecorded":false,
    "uniqueDeviceIdentifiersRecorded":false,
    "hardwareMetadataPolicy":"representative-class-or-model-only-no-serials-or-unique-identifiers"
  },
  "boundary":"These harnesses and templates are review tooling only. They may support real human, rendered, assistive-technology, device/form-factor, and performance observations against the frozen source revision, but they do not create evidence or acceptance automatically. Review outcomes must be recorded only after actual review."
}
