{
  "$schema":"../../schemas/v1.6-diagnostics-regression.schema.json",
  "schemaVersion":1,
  "contractId":"goreecloud.glaze-ui.v1.6.diagnostics-regression",
  "name":"Glaze UI V1.6 Diagnostics, Regression, Layout Stability, and Degradation Development Contract",
  "version":"1.6.0-dev.9",
  "lifecycle":"Development",
  "stableBaseline":"1.5.1",
  "consumerEligible":false,
  "implementedSpecificationSections":[80,81,82,83,84,85,86,87],
  "developerDiagnostics":{
    "checks":[
      "contrast","unsupported-token-overrides","missing-component-states",
      "excessive-blur","excessive-animation","target-size","accessible-names",
      "nested-materials","semantic-state-consistency","skeleton-duration","loading-recovery"
    ],
    "missingChecksFailClosed":true,
    "warningSuppressionMayHideFailure":false
  },
  "accessibilityDiagnostics":{
    "checks":[
      "contrast","focus-visibility","logical-focus-order","minimum-target-size",
      "reduced-motion","reduced-transparency","large-text-reflow",
      "semantic-announcements","screen-reader-labeling","color-independent-status"
    ],
    "assistiveTechnologyAcceptanceInferred":false,
    "colorOnlyStatusAllowed":false
  },
  "skeletonDiagnostics":{
    "checks":[
      "removed-when-content-ready","reduced-motion-compatible",
      "simultaneous-shimmer-budget","layout-stability","loading-semantics",
      "failure-escalation","bounded-duration","focus-continuity"
    ],
    "referenceMaxSimultaneousShimmer":12,
    "referenceMaxDurationMs":10000,
    "referenceLayoutShiftBudget":0.1,
    "referenceBudgetsDevelopmentOnly":true
  },
  "visualRegression":{
    "scenarios":[
      "light","dark","high-contrast","reduced-motion","reduced-transparency",
      "large-text","loading","skeleton-loading","offline","degraded","errors",
      "empty-states","responsive-layouts","multiple-input-methods"
    ],
    "deterministicReferenceScenesRequired":true,
    "humanVisualAcceptanceInferred":false
  },
  "semanticRegression":{
    "invariants":[
      "error-remains-error-across-themes",
      "focus-distinct-from-selection",
      "loading-not-announced-as-completion",
      "restricted-distinct-from-disabled",
      "offline-distinct-from-generic-failure"
    ],
    "themeMayChangeMeaning":false
  },
  "performanceRegression":{
    "dimensions":[
      "frame-stability","layout-stability","animation-cost","blur-cost",
      "loading-cost","skeleton-cost","memory-pressure","large-list-behavior"
    ],
    "measurementsOwnedByHarness":true,
    "budgetsOwnedByGovernedAcceptanceProfile":true,
    "thresholdsInventedByResolver":false,
    "representativeDeviceAcceptanceInferred":false
  },
  "layoutStability":{
    "preserveSpaceWherePractical":true,
    "unnecessaryWholePagePushAllowed":false,
    "dynamicContentMayEraseFocus":false,
    "measurementsOwnedByHarness":true
  },
  "gracefulDegradation":{
    "fallbacks":{
      "blur":["blur","translucent-solid","opaque-solid"],
      "morph":["morph","fade","immediate-state-change"],
      "animated-skeleton":["animated-skeleton","static-skeleton"],
      "dynamic-environmental-effect":["dynamic-environmental-effect","ordinary-semantic-surface"],
      "complex-transition":["complex-transition","direct-replacement"]
    },
    "usabilityPreserved":true,
    "semanticMeaningPreserved":true,
    "advancedEffectRequiredForComprehension":false
  },
  "authority":{
    "boundary":"evidence-evaluation-only",
    "measurementsOwnedByCallerOrHarness":true,
    "renderedEvidenceManufactured":false,
    "acceptanceInferred":false,
    "fallbackExecutionAutomatic":false,
    "consequentialExecutionAutomatic":false
  },
  "runtimeEntrypoint":"js/glaze-v1.6-diagnostics-regression.dev.mjs",
  "developmentAggregateEntrypoint":"js/glaze-v1.6-development.mjs",
  "tokenMap":"tokens/glaze-v1.6-diagnostics-regression.dev.json",
  "boundary":"Development source and evidence-evaluation foundation only. It does not establish rendered/native/human/device acceptance, lifecycle promotion, consumer eligibility, release publication, deployment, or production state."
}
