{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze.conformance-evidence.schema.json",
  "title": "Glaze UI Conformance Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "target",
    "observed_at",
    "valid_until",
    "claim",
    "acceptance",
    "evidence_references"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "authoritative"],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 160},
        "authoritative": {"const": true}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "glaze_version"],
      "properties": {
        "application": {"type": "string", "minLength": 1, "maxLength": 160},
        "glaze_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "form_factors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mobile", "tablet", "desktop", "tv", "web"]}
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "accepted"],
      "properties": {
        "kind": {"enum": ["conformance", "production_ui_acceptance"]},
        "accepted": {"type": "boolean"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stable_required", "application_specific_acceptance_complete"],
      "properties": {
        "current_stable_required": {"const": true},
        "application_specific_acceptance_complete": {"type": "boolean"}
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {"accepted": {"const": true}},
            "required": ["accepted"]
          }
        },
        "required": ["claim"]
      },
      "then": {
        "properties": {
          "acceptance": {
            "properties": {"application_specific_acceptance_complete": {"const": true}},
            "required": ["application_specific_acceptance_complete"]
          }
        }
      }
    }
  ]
}